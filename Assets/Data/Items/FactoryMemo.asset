  m_Name: FactoryMemo
  m_EditorClassIdentifier: Assembly-CSharp::NHNHackathon.Items.ItemDefinition
  itemId: Factory_Memo
  displayName: "\uB0A1\uC740 \uACF5\uC5F0 \uC9C0\uCE68\uC11C"
  itemType: 2
  progressionCondition: {fileID: 11400000, guid: 828cf8432a9a7e44c89202170bfed3ea, type: 2}
  description: "\uBD88\uB7C9\uD488 \uCC98\uB9AC \uB300\uAE30\uC2E4\uC5D0 \uB193\uC5EC
    \uC788\uB358 \uB0A1\uC740 \uC9C0\uCE68\uC11C\uC774\uB2E4."
  inventoryIcon: {fileID: -4839725608942642958, guid: 077c93c05d99fc24fbd99c5f54c582f5, type: 2}
  previewPrefab: {fileID: 6274370231951324203, guid: 26628686116e61a45b72ca5cc4242f8c, type: 3}
  previewEulerAngles: {x: -20, y: 20, z: 20}
  previewScale: 1.1
  inspectOnPickup: 1
  pages:
  - text: "\uB0B4\uAC00 \uB9CC\uB4E0 \uCDA4\uCD94\uB294 \uC778\uD615\uB4E4\uC740
      \uD070 \uC131\uACF5\uC744 \uAC70\uB450\uC5C8\uB2E4.\n\n\uC0AC\uB78C\uB4E4\uC740
      \uC0B4\uC544 \uC788\uB294 \uB4EF \uCDA4\uCD94\uB294 \uC778\uD615\uC744 \uBCF4\uAE30
      \uC704\uD574 \uBAB0\uB824\uC654\uACE0,\n\uB098\uB294 \uC774 \uC800\uD0DD \uC804\uCCB4\uB97C
      \uADF8\uB4E4\uC744 \uC704\uD55C \uACF5\uC5F0 \uACF5\uAC04\uC73C\uB85C \uBC14\uAFB8\uC5C8\uB2E4.\n\n\uD558\uC9C0\uB9CC
      \uBAA8\uB4E0 \uC778\uD615\uC774 \uC644\uBCBD\uD558\uAC8C \uC6C0\uC9C1\uC774\uB294
      \uAC83\uC740 \uC544\uB2C8\uB2E4.\n\n\uC548\uBB34\uB97C \uC81C\uB300\uB85C \uC218\uD589\uD558\uC9C0
      \uBABB\uD558\uB294 \uC778\uD615\uC740 \uBD88\uB7C9\uD488\uC73C\uB85C \uBD84\uB958\uD558\uACE0,\n\uAC10\uB3C5\uAD00\uC5D0\uAC8C
      \uACF5\uC5F0 \uC911\uC778 \uC778\uD615\uB4E4\uC744 \uD655\uC778\uD558\uB3C4\uB85D
      \uD588\uB2E4.\n\n\uC218\uB9AC\uAC00 \uD544\uC694\uD55C \uC778\uD615\uB4E4\uC740
      \uC774\uACF3\uC5D0\uC11C \uC7AC\uAC80\uC0AC\uB97C \uAE30\uB2E4\uB9B0\uB2E4."
    image: {fileID: 0}
  - text: "\uBD88\uB7C9\uD488\uC744 \uD3D0\uAE30\uD558\uAE30 \uC804 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uB3D9\uC791\uC744 \uD655\uC778\uD55C\uB2E4.\n\n@\uBC29 \uC911\uC559\uC758
      \uAE30\uC900 \uC778\uD615\uC774 \uCDA4\uC744 \uC2DC\uC791\uD558\uBA74 \uD568\uAED8
      \uC548\uBB34\uB97C \uC218\uD589\uD560 \uAC83.@\n\n\uC815\uC0C1\uC801\uC73C\uB85C
      \uC548\uBB34\uB97C \uB9C8\uCE5C \uC778\uD615\uC5D0\uAC8C\uB294\n\uB2E4\uC74C
      \uAD6C\uC5ED\uC73C\uB85C \uC774\uB3D9\uD560 \uC218 \uC788\uB3C4\uB85D \uC5F4\uC1E0\uAC00
      \uC9C0\uAE09\uB41C\uB2E4.\n\n@\uAC10\uB3C5\uAD00\uC774 \uC788\uB294 \uACF3\uC5D0\uC11C\uB294
      \uD63C\uC790 \uD589\uB3D9\uD558\uC9C0 \uB9D0 \uAC83.@\n\n\uACF5\uC5F0 \uC911\uC778
      \uC778\uD615\uB4E4 \uC0AC\uC774\uC5D0\uC11C \uD568\uAED8 \uCDA4\uCD94\uACE0
      \uC788\uB2E4\uBA74\n\uAC10\uB3C5\uAD00\uC740 \uC815\uC0C1\uC801\uC778 \uC778\uD615\uC73C\uB85C
      \uD310\uB2E8\uD55C\uB2E4.\n\n\uC7AC\uAC80\uC0AC\uB97C \uB9C8\uCCE4\uB2E4\uBA74\n@\uC11C\uC7AC\uC5D0
      \uC815\uB9AC\uD574 \uB454 \uC0C8\uB85C\uC6B4 \uC548\uBB34 \uC5F0\uAD6C\uB97C
      \uD655\uC778\uD560 \uAC83.@"
    image: {fileID: 21300000, guid: 72161deff2dca8f42bfc24d01fcea91e, type: 3}
