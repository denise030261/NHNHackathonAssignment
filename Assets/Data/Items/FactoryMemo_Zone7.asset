  itemId: Factory_Memo_Zone7
  displayName: "\uACF5\uC7A5 \uAD00\uB9AC \uAE30\uB85D (Zone7)"
  itemType: 2
  progressionCondition: {fileID: 11400000, guid: c3b8c7733409c9348b7d70687d6de0dc, type: 2}
  description: "\uAC00\uC7A5\uC790\uB9AC\uAC00 \uB0A1\uC740 \uACF5\uC7A5 \uAD00\uB9AC\uC790\uC758
    \uAE30\uB85D\uC9C0\uB2E4."
  inventoryIcon: {fileID: -4839725608942642958, guid: 077c93c05d99fc24fbd99c5f54c582f5, type: 2}
  previewPrefab: {fileID: 6274370231951324203, guid: 26628686116e61a45b72ca5cc4242f8c, type: 3}
  previewEulerAngles: {x: 0, y: 0, z: 0}
  previewScale: 1.1
  inspectOnPickup: 1
  pages:
  - text: "\uC548\uBB34 \uAC80\uC0AC \uAE30\uB85D 27\uC77C\uCC28\n\n\uC624\uB298\uB3C4
      3\uBC88 \uC0DD\uC0B0\uC120\uC5D0\uC11C \uAC19\uC740 \uACB0\uD568\uC774 \uBC1C\uACAC\uB418\uC5C8\uB2E4.
      \uBA85\uB839\uC744 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACE0 \uC8FC\uC704\uB97C
      \uC0B4\uD53C\uB294 \uC778\uD615\uC774 \uC788\uB2E4. \uAC10\uB3C5\uAD00\uC740
      \uB2E8\uC21C \uC13C\uC11C \uC624\uB958\uB77C\uACE0 \uD588\uC9C0\uB9CC, \uADF8
      \uC778\uD615\uC740 \uB0B4\uAC00 \uBCF4\uACE0 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC744
      \uC544\uB294 \uAC83\uCC98\uB7FC \uACE0\uAC1C\uB97C \uB3CC\uB838\uB2E4."
    image: {fileID: 0}
  - text: "\uD3D0\uAE30 \uC9C0\uC2DC\n\n\uACB0\uD568 \uAC1C\uCCB4\uB294 \uB2E4\uC74C
      \uAC80\uC0AC \uC885\uB8CC \uD6C4 \uC989\uC2DC \uD3D0\uAE30 \uAD6C\uC5ED\uC73C\uB85C
      \uC774\uC1A1\uD55C\uB2E4. \uB9CC\uC57D \uAC1C\uCCB4\uAC00 \uB2E4\uB978 \uC778\uD615\uC758
      \uC548\uBB34\uB97C \uC644\uBCBD\uD788 \uB530\uB77C \uD560 \uACBD\uC6B0 \uAC00\uAE4C\uC774
      \uC811\uADFC\uD558\uC9C0 \uB9D0\uACE0 \uAC10\uC2DC\uC790\uB97C \uD638\uCD9C\uD560
      \uAC83.\n\n\uCD94\uC2E0: \uCD9C\uAD6C \uC5F4\uC1E0\uB294 \uC138 \uBA85\uC758
      \uAD00\uB9AC\uC790\uC5D0\uAC8C \uB098\uB204\uC5B4 \uBCF4\uAD00\uD588\uB2E4."
    image: {fileID: 0}
