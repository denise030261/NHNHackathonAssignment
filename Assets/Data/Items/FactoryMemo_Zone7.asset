  itemId: Factory_Memo_Zone7
  displayName: "\uB9C8\uC9C0\uB9C9 \uAE30\uB85D"
  itemType: 2
  progressionCondition: {fileID: 11400000, guid: c3b8c7733409c9348b7d70687d6de0dc, type: 2}
  description: "\uCD9C\uAD6C \uADFC\uCC98\uC5D0\uC11C \uBC1C\uACAC\uB41C \uC81C\uC791\uC790\uC758
    \uB9C8\uC9C0\uB9C9 \uAE30\uB85D\uC774\uB2E4. \uB4B7\uBD80\uBD84\uC758 \uAE00\uC528\uAC00
    \uC2EC\uD558\uAC8C \uD750\uD2B8\uB7EC\uC838 \uC788\uB2E4."
  inventoryIcon: {fileID: -4839725608942642958, guid: 077c93c05d99fc24fbd99c5f54c582f5, type: 2}
  previewPrefab: {fileID: 6274370231951324203, guid: 26628686116e61a45b72ca5cc4242f8c, type: 3}
  previewEulerAngles: {x: 0, y: 0, z: 90}
  previewScale: 1.1
  inspectOnPickup: 1
  pages:
  - text: "\uB0B4 \uD310\uB2E8\uC774 \uD2C0\uB838\uB2E4.\n\n\uAC10\uB3C5\uAD00\uC740
      \uB354 \uC774\uC0C1\n\uC0AC\uB78C\uACFC \uC778\uD615\uC744 \uAD6C\uBD84\uD558\uC9C0
      \uBABB\uD55C\uB2E4.\n\n\uC815\uC9C0 \uBA85\uB839\uB3C4 \uBC1B\uC544\uB4E4\uC774\uC9C0
      \uC54A\uB294\uB2E4.\n\n\uC815\uBB38\uC740 \uC774\uBBF8 \uBD09\uC1C4\uB418\uC5C8\uB2E4.\n\n\uB0A8\uC740
      \uAE38\uC740 \uC774\uACF3\uC5D0\uC11C \uAD00\uB9AC\uD558\uB358\n\uD6C4\uBC29
      \uCD9C\uC785\uAD6C\uBFD0\uC774\uB2E4.\n\n\uB188\uC774 \uBCF5\uB3C4\uAE4C\uC9C0
      \uB530\uB77C\uC654\uB2E4."
    image: {fileID: 0}
  - text: "\uD6C4\uBC29 \uCD9C\uC785\uAD6C\uC5D0\uB294 \uC5EC\uB7EC \uAC1C\uC758
      \uC7A0\uAE08\uC7A5\uCE58\uAC00 \uC788\uB2E4.\n\n\uD55C \uBC88\uC5D0 \uC804\uBD80
      \uC5F4\uB824\uACE0 \uD558\uC9C0 \uB9C8\uB77C.\n\n\uB188\uC774 \uB2E4\uAC00\uC624\uBA74
      \uC791\uC5C5\uC744 \uBA48\uCD94\uACE0\n\uBCF5\uB3C4\uC5D0 \uB300\uAE30 \uC911\uC778
      \uC778\uD615\uB4E4 \uC0AC\uC774\uC5D0 \uC11E\uC5EC\uB77C.\n\n\uCDA4\uC744 \uCD94\uACE0
      \uC788\uC73C\uBA74 \uC9C0\uB098\uAC08 \uAC83\uC774\uB2E4.\n\n\uBA40\uC5B4\uC9C0\uBA74
      \uB2E4\uC2DC \uC7A0\uAE08\uC744 \uD480\uC5B4\uB77C.\n\n\uADF8\uB9AC\uACE0 \uBB38\uC774
      \uC5F4\uB9AC\uBA74\u2014"
    image: {fileID: 0}
