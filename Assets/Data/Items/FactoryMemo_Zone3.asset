  itemId: Factory_Memo_Zone3
  displayName: "\uC548\uBB34 \uC5F0\uAD6C \uAE30\uB85D"
  itemType: 2
  progressionCondition: {fileID: 11400000, guid: 7e29bb800fbbead4aacdd984d72aee4f, type: 2}
  description: "\uACF5\uC5F0\uC5D0 \uC0AC\uC6A9\uD560 \uC0C8\uB85C\uC6B4 \uC6C0\uC9C1\uC784\uC744
    \uC5F0\uAD6C\uD55C \uAE30\uB85D\uC774\uB2E4."
  inventoryIcon: {fileID: -4839725608942642958, guid: 077c93c05d99fc24fbd99c5f54c582f5, type: 2}
  previewPrefab: {fileID: 6274370231951324203, guid: 26628686116e61a45b72ca5cc4242f8c, type: 3}
  previewEulerAngles: {x: 0, y: 0, z: 90}
  previewScale: 1.1
  inspectOnPickup: 1
  pages:
  - text: "\uC88B\uC740 \uC778\uD615\uC744 \uB9CC\uB4DC\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294
      \uBD80\uC871\uD558\uB2E4.\n\n\uCC98\uC74C\uC5D0\uB294 \uB2E8\uC21C\uD55C \uC6C0\uC9C1\uC784\uB9CC\uC73C\uB85C\uB3C4\n\uC190\uB2D8\uB4E4\uC740
      \uC2E0\uAE30\uD574\uD588\uB2E4.\n\n\uD558\uC9C0\uB9CC \uAC19\uC740 \uCDA4\uC740
      \uAE08\uC138 \uC775\uC219\uD574\uC9C4\uB2E4.\n\n\uADF8\uB798\uC11C \uC774\uACF3\uC5D0
      \uBB34\uC6A9\uACFC \uC6C0\uC9C1\uC784\uC5D0 \uAD00\uD55C \uCC45\uC744 \uBAA8\uC73C\uACE0\n\uB354
      \uC7AC\uBBF8\uC788\uB294 \uACF5\uC5F0\uC744 \uC704\uD55C \uC548\uBB34\uB97C
      \uC5F0\uAD6C\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4.\n\n\uC624\uB298 \uC0C8\uB85C\uC6B4
      \uB3D9\uC791 \uD558\uB098\uB97C \uC815\uB9AC\uD588\uB2E4."
    image: {fileID: 0}
  - text: "\uC0AC\uC9C4\uACFC \uAC19\uC740 \uC548\uBB34\uB97C \uCD94\uAC00\uD558\uC600\uB2E4.\n\uAE30\uC874
      \uB3D9\uC791\uACFC \uD568\uAED8 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB3C4\uB85D\n\uBAA8\uB4E0
      \uC778\uD615\uC5D0 \uC801\uC6A9\uD560 \uC608\uC815\uC774\uB2E4.\n\n\uC2E4\uC81C
      \uC778\uD615\uC5D0 \uC801\uC6A9\uD588\uC744 \uB54C \uBB38\uC81C\uAC00 \uC5C6\uB294\uC9C0\uB294\n@\uC81C\uC791
      \uBC0F \uC548\uBB34 \uC2DC\uD5D8\uC2E4\uC5D0\uC11C \uD655\uC778\uD574\uC57C
      \uD55C\uB2E4.@"
    image: {fileID: 21300000, guid: 426ce0e13d4fdc54c8cdd879cda6ac1a, type: 3}
