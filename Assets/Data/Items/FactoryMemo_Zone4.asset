  itemId: Factory_Memo_Zone4
  displayName: "\uC548\uBB34 \uC2DC\uD5D8 \uAE30\uB85D"
  itemType: 2
  progressionCondition: {fileID: 11400000, guid: c74173c6495ec3a49842720480d87c82, type: 2}
  description: "\uC0C8\uB85C\uC6B4 \uC548\uBB34\uB97C \uC2E4\uC81C \uC778\uD615\uC5D0
    \uC801\uC6A9\uD55C \uC2DC\uD5D8 \uAE30\uB85D\uC774\uB2E4."
  inventoryIcon: {fileID: -4839725608942642958, guid: 077c93c05d99fc24fbd99c5f54c582f5, type: 2}
  previewPrefab: {fileID: 6274370231951324203, guid: 26628686116e61a45b72ca5cc4242f8c, type: 3}
  previewEulerAngles: {x: 0, y: 0, z: 90}
  previewScale: 1.1
  inspectOnPickup: 1
  pages:
  - text: "\uC11C\uC7AC\uC5D0\uC11C \uC815\uB9AC\uD55C \uC0C8\uB85C\uC6B4 \uB3D9\uC791\uC744\n\uC644\uC131\uB41C
      \uC778\uD615\uC5D0 \uC801\uC6A9\uD574 \uBCF4\uC558\uB2E4.\n\n\uACB0\uACFC\uB294
      \uAE30\uB300 \uC774\uC0C1\uC774\uB2E4.\n\n\uC870\uAE08 \uB354 \uB2E4\uC591\uD55C
      \uC6C0\uC9C1\uC784\uC744 \uCD94\uAC00\uD55C\uB2E4\uBA74\n\uACF5\uC5F0\uC744
      \uD6E8\uC52C \uD48D\uC131\uD558\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4.\n\n\uC0C8\uB85C\uC6B4
      \uC778\uD615\uC744 \uB9CC\uB4E4 \uB54C\uB9C8\uB2E4\n\uC774\uACF3\uC5D0\uC11C
      \uC6C0\uC9C1\uC784\uACFC \uC548\uBB34\uB97C \uD568\uAED8 \uC2DC\uD5D8\uD558\uAE30\uB85C
      \uD588\uB2E4."
    image: {fileID: 0}
  - text: "\uACF5\uC5F0\uC758 \uBCC0\uD654\uB97C \uC704\uD574\n\uB610 \uD558\uB098\uC758
      \uC548\uBB34\uB97C \uCD94\uAC00\uD55C\uB2E4.\n\n\uC2DC\uD5D8\uC744 \uD1B5\uACFC\uD55C
      \uC778\uD615\uC740 \uACF5\uC5F0 \uC804\uAE4C\uC9C0\n@\uC778\uD615 \uBCF4\uAD00
      \uCC3D\uACE0\uC5D0\uC11C \uB300\uAE30\uC2DC\uD0A8\uB2E4.@\n\n\uAC10\uB3C5\uAD00\uC740
      \uC798\uBABB\uB41C \uB3D9\uC791\uC744 \uBCF4\uC774\uB294 \uC778\uD615\uC744\n\uBD88\uB7C9\uD488\uC73C\uB85C
      \uBD84\uB958\uD558\uBBC0\uB85C \uC8FC\uC758\uD560 \uAC83."
    image: {fileID: 21300000, guid: 0a56ae6a5ba8c7a419f90d42bc290b9b, type: 3}
