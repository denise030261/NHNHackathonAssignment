  itemId: Factory_Memo_Zone5
  displayName: "\uAC10\uB3C5\uAD00 \uC810\uAC80 \uAE30\uB85D"
  itemType: 2
  progressionCondition: {fileID: 11400000, guid: 5ad50ef0b8d9b884e9bd1121a1c51e6c, type: 2}
  description: "\uAC10\uB3C5\uAD00\uC5D0\uAC8C \uB098\uD0C0\uB09C \uC774\uC0C1 \uD589\uB3D9\uC744
    \uAE30\uB85D\uD55C \uC810\uAC80 \uBB38\uC11C\uC774\uB2E4."
  inventoryIcon: {fileID: -4839725608942642958, guid: 077c93c05d99fc24fbd99c5f54c582f5, type: 2}
  previewPrefab: {fileID: 6274370231951324203, guid: 26628686116e61a45b72ca5cc4242f8c, type: 3}
  previewEulerAngles: {x: 0, y: 0, z: 90}
  previewScale: 1.1
  inspectOnPickup: 1
  pages:
  - text: "\uCD5C\uADFC \uAC10\uB3C5\uAD00\uC758 \uD310\uB2E8\uC774 \uC774\uC0C1\uD558\uB2E4.\n\n\uCC98\uC74C\uC5D0\uB294
      \uC778\uD615 \uD558\uB098\uB97C\n\uC798\uBABB \uBD84\uB958\uD55C \uC815\uB3C4\uB77C\uACE0
      \uC0DD\uAC01\uD588\uB2E4.\n\n\uD558\uC9C0\uB9CC \uC624\uB298\uC740 \uC791\uC5C5\uC790\uC5D0\uAC8C\uAE4C\uC9C0
      \uC811\uADFC\uD588\uB2E4.\n\n\uC0AC\uB78C\uACFC \uC778\uD615\uC744 \uAD6C\uBD84\uD558\uB294
      \uACFC\uC815\uC5D0\n\uBB38\uC81C\uAC00 \uC0DD\uAE34 \uAC83\uC77C\uC9C0\uB3C4
      \uBAA8\uB978\uB2E4.\n\n\uACF5\uC5F0\uC774 \uB05D\uB098\uB294 \uB300\uB85C \uC810\uAC80\uD574\uC57C\uACA0\uB2E4."
    image: {fileID: 0}
  - text: "\uC810\uAC80\uC774 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0\n\uAC10\uB3C5\uAD00
      \uC8FC\uBCC0\uC5D0\uC11C\uB294 \uAE09\uD558\uAC8C \uD589\uB3D9\uD558\uC9C0
      \uB9D0 \uAC83.\n\n\uAC10\uB3C5\uAD00\uC774 \uC811\uADFC\uD558\uBA74\n\uAC00\uAE4C\uC6B4
      \uC778\uD615 \uBB34\uB9AC\uC5D0 \uC11E\uC5EC \uC548\uBB34\uB97C \uC720\uC9C0\uD55C\uB2E4.\n\n\uD655\uC778\uC774
      \uB05D\uB098\uACE0 \uBA40\uC5B4\uC9C4 \uB4A4 \uC774\uB3D9\uD560 \uAC83.\n\n\uCC3D\uACE0\uC758
      \uC778\uD615\uB4E4\uC740 \uACF5\uC5F0 \uAD6C\uC5ED\uC73C\uB85C \uC62E\uAE38
      \uB54C\n@\uBCF4\uC548 \uCD9C\uC785 \uBCF5\uB3C4\uB97C \uC774\uC6A9\uD55C\uB2E4.@"
    image: {fileID: 0}
